datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// ApplyFlow cloud account (B2C). Scoped by authenticated Supabase user subject.
model ApplyFlowAccount {
  id              String   @id @default(uuid()) @db.Uuid
  authProviderSub String   @unique @map("auth_provider_sub")
  email           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("applyflow_accounts")
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Canonical source of truth for an ApplyFlow account's dashboard data.
/// Independent of pilot eligibility and of MigrationSession lifecycle.
enum ApplyFlowCanonicalPersistence {
  v1_local
  v2_cloud
}

/// ApplyFlow cloud account (B2C). Scoped by authenticated Supabase user subject.
model ApplyFlowAccount {
  id                     String                         @id @default(uuid()) @db.Uuid
  authProviderSub        String                         @unique @map("auth_provider_sub")
  email                  String?
  /// When true (and GLOBAL V2 flag ON), account may enter Persistence V2 pilot.
  /// Default false — never auto-grant.
  pilotEligible          Boolean                        @default(false) @map("pilot_eligible")
  /// What is canonical for this account. Default v1_local. Never auto v2_cloud.
  canonicalPersistence   ApplyFlowCanonicalPersistence  @default(v1_local) @map("canonical_persistence")
  createdAt              DateTime                       @default(now()) @map("created_at")
  updatedAt              DateTime                       @updatedAt @map("updated_at")

  jobs                   ApplyFlowJob[]
  applications           ApplyFlowApplication[]
  migrationSessions      ApplyFlowMigrationSession[]
  profileDocument        ApplyFlowProfileDocument?
  contacts               ApplyFlowContactRecord[]
  contactInteractions    ApplyFlowContactInteractionRecord[]
  inboundResponses       ApplyFlowInboundResponseRecord[]
  careerEvents           ApplyFlowCareerEventRecord[]
  personalImportSessions ApplyFlowPersonalImportSession[]
  extensionGrants        ApplyFlowExtensionGrant[]

  @@map("applyflow_accounts")
}

/// Canonical inbox Job. Client-stable `id` (V1 `job_…`) scoped by account.
///
/// Job→Application link is application-owned via `ApplyFlowApplication.sourceJobId`
/// (soft reference). A composite Prisma FK `(accountId, sourceJobId) → Job` with
/// `onDelete: SetNull` is unsafe in PostgreSQL because SET NULL would also null
/// `accountId` and destroy ownership. Repository delete nulls `sourceJobId` only.
model ApplyFlowJob {
  accountId                String   @map("account_id") @db.Uuid
  id                       String
  title                    String
  company                  String?
  location                 String?
  url                      String?
  canonicalUrl             String?  @map("canonical_url")
  source                   String
  status                   String
  jobContext               Json     @map("job_context")
  descriptionSnapshot      String?  @map("description_snapshot")
  descriptionHash          String?  @map("description_hash")
  jobMatch                 Json     @map("job_match")
  evaluatedWith            Json?    @map("evaluated_with")
  curriculumRecommendation Json?    @map("curriculum_recommendation")
  applicationPack          Json?    @map("application_pack")
  version                  Int      @default(1)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, id])
  @@index([accountId, canonicalUrl])
  @@index([accountId, descriptionHash])
  @@map("applyflow_jobs")
}

/// Canonical Application (separate entity). Optional soft link to Job via sourceJobId.
///
/// AF-REL-001 invariant (DB-enforced): at most one Application per
/// (accountId, sourceJobId) when sourceJobId IS NOT NULL.
/// Prisma 6 cannot express partial unique indexes in-schema; the authoritative
/// constraint is migration `20260928180000_application_source_job_unique`
/// (`applyflow_applications_account_id_source_job_id_uidx`).
/// Multiple rows with sourceJobId = NULL remain allowed. Uniqueness is peri-account,
/// not global on sourceJobId alone.
model ApplyFlowApplication {
  accountId   String    @map("account_id") @db.Uuid
  id          String
  sourceJobId String?   @map("source_job_id")
  source      String
  status      String
  jobTitle    String?   @map("job_title")
  companyName String?   @map("company_name")
  jobUrl      String?   @map("job_url")
  fitScore    Float?    @map("fit_score")
  notes       String?
  jobMeta     Json?     @map("job_meta")
  v2Meta      Json?     @map("v2_meta")
  extras      Json?
  appliedAt   DateTime? @map("applied_at")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, id])
  @@map("applyflow_applications")
}

/// Durable V1→V2 migration session. Idempotent on (account, sourceVersion, fingerprint).
/// Browser local marker is NOT authoritative — this session is server completion proof.
model ApplyFlowMigrationSession {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id") @db.Uuid
  sourceVersion         Int       @map("source_version")
  bundleFingerprint     String    @map("bundle_fingerprint")
  status                String
  expectedJobs          Int       @map("expected_jobs")
  expectedApplications  Int       @map("expected_applications")
  processedJobs         Int       @default(0) @map("processed_jobs")
  processedApplications Int       @default(0) @map("processed_applications")
  conflictSummary       Json?     @map("conflict_summary")
  startedAt             DateTime  @default(now()) @map("started_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  completedAt           DateTime? @map("completed_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, sourceVersion, bundleFingerprint], map: "applyflow_migration_sessions_account_source_fp_key")
  @@index([accountId, status])
  @@map("applyflow_migration_sessions")
}

/// Account-owned resume library. One document per account. OCC via version.
/// Binary files are not stored here; the domain library is private JSON, never a public URL.
model ApplyFlowProfileDocument {
  accountId   String   @id @map("account_id") @db.Uuid
  library     Json
  version     Int      @default(1)
  fingerprint String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("applyflow_profile_documents")
}

model ApplyFlowContactRecord {
  accountId     String   @map("account_id") @db.Uuid
  id            String
  applicationId String?  @map("application_id")
  jobId         String?  @map("job_id")
  payload       Json
  version       Int      @default(1)
  fingerprint   String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, id])
  @@index([accountId, applicationId])
  @@index([accountId, jobId])
  @@map("applyflow_contacts")
}

model ApplyFlowContactInteractionRecord {
  accountId     String   @map("account_id") @db.Uuid
  id            String
  contactId     String   @map("contact_id")
  applicationId String?  @map("application_id")
  jobId         String?  @map("job_id")
  payload       Json
  fingerprint   String
  createdAt     DateTime @default(now()) @map("created_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, id])
  @@index([accountId, contactId])
  @@map("applyflow_contact_interactions")
}

/// Human-confirmed response detections.
/// Dedup identity is (account, provider, message id). Sender domain is not the key.
model ApplyFlowInboundResponseRecord {
  accountId     String   @map("account_id") @db.Uuid
  id            String
  provider      String
  emailId       String   @map("email_id")
  applicationId String?  @map("application_id")
  state         String
  payload       Json
  version       Int      @default(1)
  fingerprint   String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, id])
  @@unique([accountId, provider, emailId], map: "applyflow_inbound_responses_account_provider_email_key")
  @@index([accountId, applicationId])
  @@map("applyflow_inbound_responses")
}

/// Real transition events. Not derived from updatedAt or notes.
model ApplyFlowCareerEventRecord {
  accountId     String   @map("account_id") @db.Uuid
  id            String
  applicationId String   @map("application_id")
  jobId         String?  @map("job_id")
  eventType     String   @map("event_type")
  occurredAt    DateTime @map("occurred_at")
  dedupeKey     String   @map("dedupe_key")
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, id])
  @@unique([accountId, dedupeKey], map: "applyflow_career_events_account_dedupe_key")
  @@index([accountId, applicationId, occurredAt])
  @@map("applyflow_career_events")
}

/// Resumable import of personal modules. Does not change canonicalPersistence.
model ApplyFlowPersonalImportSession {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  module            String
  bundleFingerprint String    @map("bundle_fingerprint")
  status            String
  expectedCount     Int       @map("expected_count")
  processedCount    Int       @default(0) @map("processed_count")
  conflictSummary   Json?     @map("conflict_summary")
  startedAt         DateTime  @default(now()) @map("started_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  completedAt       DateTime? @map("completed_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, module, bundleFingerprint], map: "applyflow_personal_import_account_module_fp_key")
  @@index([accountId, status])
  @@map("applyflow_personal_import_sessions")
}

/// Opaque extension grant. Only the hash is stored. Logout revokes; Nango disconnect does not.
model ApplyFlowExtensionGrant {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account ApplyFlowAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, revokedAt])
  @@map("applyflow_extension_grants")
}

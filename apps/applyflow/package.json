{
  "name": "applyflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010 --webpack",
    "build": "prisma generate && next build --webpack",
    "db:generate": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node ./scripts/persistence-v2/run-prisma.cjs migrate deploy",
    "db:status": "node ./scripts/persistence-v2/run-prisma.cjs migrate status",
    "db:audit": "node scripts/persistence-v2/f3-5-env-audit.mjs",
    "start": "next start --port 3010",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@devflow/applyflow-core": "workspace:*",
    "@devflow/career-core": "workspace:*",
    "@devflow/career-sync": "workspace:*",
    "@nangohq/frontend": "^0.70.6",
    "@nangohq/node": "^0.70.6",
    "@prisma/client": "^6.0.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.49.8",
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}

# ApplyFlow / Career Suite — environment template
#
# Copy to .env.local for local development. Never commit real secrets.
# Groups below: Auth · Persistence · Providers · Observability · E2E / testing · Career (optional)
#
# All feature flags default OFF when unset unless noted.
# See docs/applyflow/PRODUCTION_READINESS.md and docs/applyflow/CLOSED_BETA_RUNBOOK.md

# =============================================================================
# Auth (V2 / hosted sessions)
# =============================================================================
# Required for real authenticated V2 users on hosted environments.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# Canonical public origin of this ApplyFlow host (scheme + host + optional port).
# Used as Origin allowlist for Nango + ApplyFlow mutating routes. Hosted: https.
# Preview also allows platform-injected VERCEL_URL for this deployment only.
# NEXT_PUBLIC_APPLYFLOW_URL=http://localhost:3010

# =============================================================================
# Persistence V2 (default OFF; local-first unchanged when OFF)
# =============================================================================
# APPLYFLOW_PERSISTENCE_V2=false
#
# LOCAL DEVELOPMENT DATABASE (Docker — preferred):
#   pnpm db:up
#   pnpm db:migrate
# DATABASE_URL=postgresql://applyflow:applyflow_local_dev@localhost:5434/applyflow
# DIRECT_URL=postgresql://applyflow:applyflow_local_dev@localhost:5434/applyflow
# APPLYFLOW_DB_TARGET=local
#
# Optional managed PostgreSQL for Career Suite feedback / V2 (same vars).
# When absent, Career Suite DB component stays disabled (no silent persistence).
#
# DO NOT point .env.local at Production Supabase project qygwhuwvilkekfkgoizb.
# Production credentials belong outside auto-loaded local/test env files.
# Destructive E2E (APPLYFLOW_F3_5_E2E=1) is fail-closed against Production / any *.supabase.co.

# =============================================================================
# Providers — job discovery (server-only)
# =============================================================================
# Jobgether: no key (default free discovery).
# Remote OK: no key (cached catalog).
# TheirStack: credit-based; DISABLED by default on Vercel production/preview
# (no distributed rate limiter). Opt-in only for single-tenant personal use.
# APPLYFLOW_THEIRSTACK_ENABLED=
# THEIRSTACK_API_KEY=

# =============================================================================
# Observability (closed beta ops)
# =============================================================================
# APPLYFLOW_SENTRY_DSN=
# (or SENTRY_DSN — operator configures before inviting multi-user cohort)

# Client-safe build metadata (no secrets).
# NEXT_PUBLIC_APP_VERSION=
# NEXT_PUBLIC_COMMIT_SHA=
# NEXT_PUBLIC_BUILD_TIMESTAMP=

# =============================================================================
# E2E / testing ONLY — NEVER enable on Vercel platform / production hosts
# =============================================================================
# APPLYFLOW_E2E=1
# APPLYFLOW_E2E_SECRET=
# APPLYFLOW_E2E_PROVIDER_FIXTURES=1
# APPLYFLOW_E2E_IGNORE_SUPABASE=1

# =============================================================================
# Career Suite — optional providers / LLM / automation (server-only; default-off)
# =============================================================================
# Full sandbox runbook:
# docs/career-suite/integrations/NANGO-SANDBOX-RUNTIME-VALIDATION-RUNBOOK.md
#
# CAREER_PROVIDER_RUNTIME_ENABLED=true
# NANGO_RUNTIME_ENABLED=true
# GMAIL_PROVIDER_ENABLED=true
# CALENDAR_PROVIDER_ENABLED=true
# LIBRECHAT_ADAPTER_ENABLED=true
# CAREER_LLM_ENABLED=true
#
# NANGO_SECRET_KEY=replace_me
# Nango integration config keys are code-defined (not env):
#   gmail    → google-mail
#   calendar → google-calendar
# OAuth scopes (code-defined):
#   gmail    → gmail.metadata.read
#   calendar → calendar.events.read
#
# LibreChat adapter / transport:
# LIBRECHAT_ADAPTER_ENABLED=true
# LIBRECHAT_TRANSPORT_ENABLED=false
# LIBRECHAT_BASE_URL=
# LIBRECHAT_API_KEY=
# LIBRECHAT_TIMEOUT_MS=10000
#
# Controlled LLM boundary — CAREER_LLM_PROVIDER defaults to "mock".
# Set to "openai" only with server-side key AND model; never expose to client.
# CAREER_LLM_ENABLED=false
# CAREER_LLM_PROVIDER=mock
# OPENAI_API_KEY=
# CAREER_LLM_MODEL=
# CAREER_LLM_TIMEOUT_MS=15000
# CAREER_LLM_MAX_RETRIES=1
#
# Approved automation boundary (single explicit run; no queue/worker):
# CAREER_AUTOMATION_ENABLED=true
# CAREER_AUTOMATION_PROVIDER=mock
# CAREER_AUTOMATION_PROVIDER=openclaw
# OPENCLAW_API_KEY=replace_me
# OPENCLAW_BASE_URL=https://replace_me
# OPENCLAW_ENABLED=false
#
# Career Suite environment matrix (optional override):
# CAREER_RUNTIME_ENVIRONMENT=   # development | test | preview | production
# CAREER_AGENTS_ENABLED=true
# CAREER_PILOT_MODE=false
# NEXT_PUBLIC_CAREER_PILOT_MODE=false
# CAREER_SYSTEM_STATUS_ENABLED=false

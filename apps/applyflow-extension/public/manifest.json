{
  "manifest_version": 3,
  "name": "ApplyFlow",
  "version": "0.2.0",
  "description": "Copiloto assistido para LinkedIn Easy Apply (DevFlow Labs). Não envia candidaturas automaticamente.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3010/*",
    "http://127.0.0.1:3012/*",
    "http://localhost:3010/*",
    "http://localhost:3012/*",
    "https://www.linkedin.com/*",
    "https://api.openai.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:3010/*",
      "http://127.0.0.1:3012/*",
      "http://localhost:3010/*",
      "http://localhost:3012/*"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "http://127.0.0.1:3010/extension-fixture*",
        "http://127.0.0.1:3012/extension-fixture*",
        "http://localhost:3010/extension-fixture*",
        "http://localhost:3012/extension-fixture*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

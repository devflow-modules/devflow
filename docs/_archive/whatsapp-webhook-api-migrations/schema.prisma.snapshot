// WhatsApp Webhook API — Tenant, Conversation, Message
datasource db {
  provider  = "postgresql"
  url       = env("WHATSAPP_DATABASE_URL")
  directUrl = env("WHATSAPP_DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model Tenant {
  id                   String         @id @default(cuid())
  name                 String?        @map("name")
  whatsappPhone        String?        @map("whatsapp_phone")   // normalized phone for resolution
  systemPrompt         String?        @map("system_prompt") @db.Text
  defaultPrompt        String?        @map("default_prompt") @db.Text
  businessType         String?        @map("business_type")
  phoneNumberId        String?        @unique @map("phone_number_id")  // optional until onboarding step 1
  displayPhoneNumber   String?        @map("display_phone_number")
  accessToken          String?        @map("access_token")             // optional until onboarding step 1
  apiKey               String?        @unique @map("api_key")   // for API key resolution
  subdomain            String?        @unique @map("subdomain")  // for subdomain resolution
  stripeCustomerId     String?        @map("stripe_customer_id")
  plan                 String?        @map("plan")             // starter | pro
  activeUntil          DateTime?      @map("active_until")
  aiDriver             String?        @map("ai_driver")        // ruleBased | openAI | claude
  crmWebhookUrl        String?        @map("crm_webhook_url")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  users                User[]
  conversations        Conversation[]
  conversationQueues   ConversationQueue[]
  agentStatuses        AgentStatus[]

  faqs                FAQ[]

  @@map("whatsapp_tenants")
}

model FAQ {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  question  String   @db.Text
  answer    String   @db.Text
  keywords  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("whatsapp_faqs")
}

model MessageFeedback {
  id             String   @id @default(cuid())
  messageId      String   @map("message_id")
  conversationId String   @map("conversation_id")
  rating         Int      // 1 or -1
  agentId        String?  @map("agent_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([messageId])
  @@map("whatsapp_message_feedback")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   // admin | agent
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("whatsapp_users")
}

model Conversation {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  externalId String   @map("external_id") // e.g. wa_id (phone)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages  Message[]
  queueEntries ConversationQueue[]

  @@unique([tenantId, externalId])
  @@map("whatsapp_conversations")
}

model ConversationQueue {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  conversationId String       @map("conversation_id")
  priority       Int          @default(0)
  queuedAt       DateTime     @default(now()) @map("queued_at")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, queuedAt])
  @@map("whatsapp_conversation_queue")
}

model AgentStatus {
  id                   String       @id @default(cuid())
  tenantId              String       @map("tenant_id")
  userId                String       @map("user_id")
  status                String       // available | busy | offline
  currentConversationId String?      @map("current_conversation_id")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("whatsapp_agent_status")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  sender         String   // "user" | "business" or wa_id
  messageType    String   @map("message_type") // text, image, audio, etc.
  content        String   @db.Text
  timestamp      DateTime @default(now())
  responseTimeMs Int?     @map("response_time_ms")
  agentId        String?  @map("agent_id")
  intent         String?  @map("intent")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@map("whatsapp_messages")
}
